DEFINE SCHEMA

    RECORD TYPE CD_BodyMeasurement (
        CD_conditions   STRING,
        CD_createdAt    TIMESTAMP,
        CD_day          STRING,
        CD_deletedAt    TIMESTAMP,
        CD_device       STRING,
        CD_entityName   STRING,
        CD_importKey    STRING,
        CD_kind         STRING,
        CD_method       STRING,
        CD_modifiedAt   TIMESTAMP,
        CD_note         STRING,
        CD_time         TIMESTAMP,
        CD_uuid         STRING,
        CD_values       STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_DayMark (
        CD_createdAt    TIMESTAMP,
        CD_day          STRING,
        CD_deletedAt    TIMESTAMP,
        CD_entityName   STRING,
        CD_importKey    STRING,
        CD_key          STRING,
        CD_kind         STRING,
        CD_meta         STRING,
        CD_modifiedAt   TIMESTAMP,
        CD_note         STRING,
        CD_time         TIMESTAMP,
        CD_uuid         STRING,
        CD_values       STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Food (
        CD_aliases      STRING,
        CD_barcode      STRING,
        CD_brand        STRING,
        CD_catalogID    STRING,
        CD_category     STRING,
        CD_createdAt    TIMESTAMP,
        CD_deletedAt    TIMESTAMP,
        CD_density      DOUBLE,
        CD_entityName   STRING,
        CD_importKey    STRING,
        CD_isFavorite   INT64,
        CD_isHidden     INT64,
        CD_modifiedAt   TIMESTAMP,
        CD_name         STRING,
        CD_nameDE       STRING,
        CD_notes        STRING,
        CD_nutrients    STRING,
        CD_servings     STRING,
        CD_source       STRING,
        CD_tags         STRING,
        CD_unit         STRING,
        CD_usualAmount  DOUBLE,
        CD_uuid         STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_LogEntry (
        CD_baseUnit     STRING,
        CD_brand        STRING,
        CD_category     STRING,
        CD_createdAt    TIMESTAMP,
        CD_day          STRING,
        CD_deletedAt    TIMESTAMP,
        CD_entityName   STRING,
        CD_foodRef      STRING,
        CD_groupID      STRING,
        CD_importKey    STRING,
        CD_meal         STRING,
        CD_modifiedAt   TIMESTAMP,
        CD_name         STRING,
        CD_note         STRING,
        CD_nutrients    STRING,
        CD_planKey      STRING,
        CD_quantity     DOUBLE,
        CD_sortOrder    DOUBLE,
        CD_source       STRING,
        CD_status       STRING,
        CD_tags         STRING,
        CD_time         TIMESTAMP,
        CD_unitAmount   DOUBLE,
        CD_unitLabel    STRING,
        CD_uuid         STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_NinaProfile (
        CD_activity           STRING,
        CD_activityBonusShare DOUBLE,
        CD_birthYear          INT64,
        CD_coachPlan          STRING,
        CD_createdAt          TIMESTAMP,
        CD_dayStartHour       INT64,
        CD_energyUnit         STRING,
        CD_entityName         STRING,
        CD_focusNutrients     STRING,
        CD_foodLanguage       STRING,
        CD_goal               STRING,
        CD_heightCm           DOUBLE,
        CD_macroSplit         STRING,
        CD_meals              STRING,
        CD_modifiedAt         TIMESTAMP,
        CD_ratePerWeek        DOUBLE,
        CD_sex                STRING,
        CD_syncedSettings     STRING,
        CD_targetWeight       DOUBLE,
        CD_targets            STRING,
        CD_trainingDays       STRING,
        CD_trainingTargets    STRING,
        CD_uuid               STRING,
        CD_waterGlass         DOUBLE,
        "___createTime"       TIMESTAMP,
        "___createdBy"        REFERENCE,
        "___etag"             STRING,
        "___modTime"          TIMESTAMP,
        "___modifiedBy"       REFERENCE,
        "___recordID"         REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PlanRule (
        CD_createdAt    TIMESTAMP,
        CD_deletedAt    TIMESTAMP,
        CD_endDay       STRING,
        CD_entityName   STRING,
        CD_isActive     INT64,
        CD_meal         STRING,
        CD_minutes      INT64,
        CD_modifiedAt   TIMESTAMP,
        CD_notify       INT64,
        CD_recipeID     STRING,
        CD_startDay     STRING,
        CD_title        STRING,
        CD_uuid         STRING,
        CD_weekdays     STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ProgressPhoto (
        CD_createdAt         TIMESTAMP,
        CD_day               STRING,
        CD_deletedAt         TIMESTAMP,
        CD_entityName        STRING,
        CD_image             BYTES,
        CD_image_ckAsset     ASSET,
        CD_measurementID     STRING,
        CD_modifiedAt        TIMESTAMP,
        CD_note              STRING,
        CD_pose              STRING,
        CD_thumbnail         BYTES,
        CD_thumbnail_ckAsset ASSET,
        CD_time              TIMESTAMP,
        CD_uuid              STRING,
        "___createTime"      TIMESTAMP,
        "___createdBy"       REFERENCE,
        "___etag"            STRING,
        "___modTime"         TIMESTAMP,
        "___modifiedBy"      REFERENCE,
        "___recordID"        REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Recipe (
        CD_createdAt    TIMESTAMP,
        CD_defaultMeal  STRING,
        CD_deletedAt    TIMESTAMP,
        CD_emoji        STRING,
        CD_entityName   STRING,
        CD_importKey    STRING,
        CD_isFavorite   INT64,
        CD_kind         STRING,
        CD_lastUsedAt   TIMESTAMP,
        CD_modifiedAt   TIMESTAMP,
        CD_name         STRING,
        CD_notes        STRING,
        CD_servings     DOUBLE,
        CD_sortOrder    DOUBLE,
        CD_tags         STRING,
        CD_totalWeight  DOUBLE,
        CD_uuid         STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_RecipeItem (
        CD_baseUnit     STRING,
        CD_brand        STRING,
        CD_category     STRING,
        CD_entityName   STRING,
        CD_foodRef      STRING,
        CD_name         STRING,
        CD_nutrients    STRING,
        CD_quantity     DOUBLE,
        CD_recipe       STRING,
        CD_sortOrder    DOUBLE,
        CD_unitAmount   DOUBLE,
        CD_unitLabel    STRING,
        CD_uuid         STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WaterLog (
        CD_amount       DOUBLE,
        CD_createdAt    TIMESTAMP,
        CD_day          STRING,
        CD_deletedAt    TIMESTAMP,
        CD_entityName   STRING,
        CD_modifiedAt   TIMESTAMP,
        CD_time         TIMESTAMP,
        CD_uuid         STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WeightEntry (
        CD_bodyFat      DOUBLE,
        CD_createdAt    TIMESTAMP,
        CD_day          STRING,
        CD_deletedAt    TIMESTAMP,
        CD_entityName   STRING,
        CD_kilograms    DOUBLE,
        CD_modifiedAt   TIMESTAMP,
        CD_note         STRING,
        CD_time         TIMESTAMP,
        CD_uuid         STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
