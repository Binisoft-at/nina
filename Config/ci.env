# App settings for the shared CI scripts (scripts/ci, synced from the Binisoft handbook).
# This file belongs to the app; sync never touches it. Defaults are derived from APP_NAME.
APP_NAME=Nina

# Schemes and paths (defaults): IOS_SCHEME=Nina MAC_SCHEME=NinaMac WATCH_SCHEME=NinaWatch
# WIDGETS_TARGET=NinaWidgets CORE_PACKAGE=Packages/NinaCore

# Targets this app has (1 = yes, 0 = no).
HAS_MAC=1
HAS_WATCH=1
HAS_WIDGETS=1

# The watch app carries its own complications extension, so the entitlement check lists every bundle.
ENTITLEMENTS_IOS="Nina.app|Config/iOS/Nina.entitlements Nina.app/Watch/NinaWatch.app|Config/watchOS/NinaWatch.entitlements Nina.app/Watch/NinaWatch.app/PlugIns/NinaWatchWidgets.appex|Config/WatchWidgets/NinaWatchWidgets.entitlements Nina.app/PlugIns/NinaWidgets.appex|Config/Widgets/NinaWidgets.entitlements"

# [screenshots] runs: screens opened with `-Demo -DemoScreen <name>` (see AppModel.applyLaunchOptions).
# "tour" opens the tour; "tour:<step>" opens it at a step.
SCREENSHOT_SCREENS="today add create foods food recipes plan insights goals nutrition import settings body measure checkin myplan phase review tour tour:quick"
WATCH_SCREENS="today"
MAC_SCREENS="today foods insights body"
